# Copy this to /etc/sanad/sanad.env on the server; never commit the filled-in file.
NODE_ENV=production
POSTGRES_USER=sanad
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=sanad_db
# The native API service builds DATABASE_URL from the three values above and
# connects to PostgreSQL running locally at 127.0.0.1:5432.
SANAD_API_PORT=3001
SANAD_WEB_PORT=3000

JWT_ACCESS_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-value-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com
TRUST_PROXY=1
SWAGGER_ENABLED=false

SENTRY_DSN=
SENTRY_ENVIRONMENT=production

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.example.com
R2_ENDPOINT=

# Optional when SMTP is complete; when both are set, Resend is the fallback.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM_EMAIL=noreply@example.com

REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend deployment.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Customer payment is arranged externally through WhatsApp, then reconciled
# and confirmed by an administrator before fulfilment begins.
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters

THROTTLE_TTL=60
THROTTLE_LIMIT=60
MAX_FILE_SIZE=10485760
