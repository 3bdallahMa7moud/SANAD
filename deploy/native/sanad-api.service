[Unit]
Description=SANAD API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=sanad
Group=sanad
WorkingDirectory=/opt/SANAD/backend
ExecStart=/opt/SANAD/deploy/native/start-api.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/SANAD/backend/uploads /var/backups/sanad
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
